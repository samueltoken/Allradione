{
  "name": "allradione",
  "productName": "Allradione",
  "version": "0.1.0",
  "description": "A globe-spanning portable radio with tactile tuning and desktop widgets.",
  "author": "samueltoken",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win portable zip --x64 --publish never",
    "test:native": "node scripts/smoke-electron.cjs",
    "test:audio": "electron --mute-audio tests/electron-audio-backend.smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "hls.js": "^1.6.13",
    "i18n-iso-countries": "^7.14.0",
    "lucide": "^0.468.0",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "io.github.samueltoken.allradione",
    "productName": "Allradione",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**",
      "licenses/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Allradione-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": false
    }
  }
}
