{
  "name": "allradione",
  "productName": "Allradione",
  "version": "0.2.6",
  "description": "World radio with a tactile tuner, a 3D globe and transparent desktop widgets.",
  "author": "samueltoken",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && npm run build:launcher && electron-builder --win nsis --x64 --publish never",
    "test:native": "node scripts/smoke-electron.cjs",
    "test:audio": "electron --mute-audio tests/electron-audio-backend.smoke.cjs",
    "test:installer": "node scripts/smoke-installer.cjs",
    "build:launcher": "node scripts/build-desktop-launcher.cjs"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "flag-icons": "^7.6.0",
    "hls.js": "^1.6.13",
    "i18n-iso-countries": "^7.14.0",
    "lucide": "^0.468.0",
    "pretendard": "^1.3.9",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "io.github.samueltoken.allradione",
    "productName": "Allradione",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**",
      "licenses/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Allradione-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Allradione",
      "uninstallDisplayName": "Allradione",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "electron/installer.nsh"
    },
    "extraResources": [
      {
        "from": "assets/desktop-launcher.exe",
        "to": "desktop-launcher.exe"
      }
    ]
  }
}
